# Todas as variáveis são opcionais: os padrões abaixo apontam para o docker-compose local.

# HTTP
PORT=3000
LOG_LEVEL=info
# Prazo do encerramento gracioso; mantenha abaixo do tempo de parada do orquestrador.
SHUTDOWN_TIMEOUT_MS=8000

# PostgreSQL
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
DB_POOL_MAX=20
# Espera máxima por lock de linha; estourada, a operação responde 503 (ou volta à fila).
DB_LOCK_TIMEOUT_MS=3000

# SQS (MiniStack)
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_TRANSACTIONS_QUEUE=wager-transactions.fifo
SQS_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wager-events.fifo

# Consumer da fila de transações
CONSUMER_ENABLED=true
CONSUMER_VISIBILITY_TIMEOUT_SECONDS=30
CONSUMER_WAIT_TIME_SECONDS=2
CONSUMER_RETRY_BASE_SECONDS=2
CONSUMER_MAX_RECEIVE_COUNT=5

# Publisher da outbox e worker de referências pendentes
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_PUBLISHER_INTERVAL_MS=500
PENDING_WORKER_ENABLED=true
PENDING_WORKER_INTERVAL_MS=1000
